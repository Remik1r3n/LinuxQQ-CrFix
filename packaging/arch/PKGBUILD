# 发布用 PKGBUILD：直接构建本仓库的工作树（CI 使用）。
# AUR 上的 qq-crfix-git 从 git 拉取源码，见仓库 README。
# Maintainer: Remik1r3n <remik1r3n@users.noreply.github.com>
pkgname=qq-crfix
pkgver=${CRFIX_VERSION:-0.0.0}
pkgrel=1
pkgdesc="Linux QQ ChromeOS Fix：让 Linux QQ 在 ChromeOS Crostini 下以原生 Wayland 运行并使用 ChromeOS 输入法"
arch=('x86_64' 'aarch64')
url="https://github.com/Remik1r3n/LinuxQQ-CrFix"
license=('MIT')
depends=('glibc' 'libx11' 'wayland' 'linuxqq')
makedepends=('pkgconf')
conflicts=('linuxqq-clipsync' 'qq-crfix-git' 'linuxqq-wayland-fix')
options=('!debug')

_root="$startdir/../.."

build() {
    make -C "$_root" clean
    make -C "$_root" VERSION="$pkgver"
}

package() {
    make -C "$_root" install DESTDIR="$pkgdir" PREFIX=/usr VERSION="$pkgver"
}
