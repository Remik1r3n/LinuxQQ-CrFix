#!/bin/bash
# Linux QQ ChromeOS Fix (qq-crfix) @VERSION@ —— 让 Linux QQ 在 ChromeOS Crostini 下以原生 Wayland 舒服地运行。
# https://github.com/Remik1r3n/LinuxQQ-CrFix
#
#   qq-crfix [QQ 的参数...]   启动 QQ（应用菜单里的「QQ (CrFix)」就是它）
#   qq-crfix --doctor         检查运行环境与当前 QQ 版本
#   qq-crfix --version
#   qq-crfix install          覆盖原生 QQ 快捷方式（原来的「QQ」改为启动修复版，隐藏「QQ (CrFix)」）
#   qq-crfix uninstall        取消覆盖，恢复原生 QQ 快捷方式
#
# 默认给 QQ 加的参数：
#   --ozone-platform=wayland --enable-wayland-ime --wayland-text-input-version=1
#   ChromeOS 的输入法（crosim）只支持 text-input-v1，而 Chromium/Electron 默认会去要 v3；
#   后两个参数让 QQ 走 Sommelier 认得的 v1，ChromeOS 原生输入法才能在 QQ 里打字。
#
# 本项目不会给 QQ 传 --use-angle=* 或设置 VK_DRIVER_FILES：
#   Crostini 的 Vulkan（VirGL/Venus 虚拟 GPU）会让整个 QQ 花屏，任何 ANGLE/Vulkan 后端选择都没有意义。
#
# 环境变量：
#   QQ_CRFIX_QQ               QQ 的启动命令（默认先找 PATH 里的 linuxqq，再找 /opt/QQ/qq）
#   QQ_CRFIX_LOG              日志文件（默认 $XDG_RUNTIME_DIR/qq-crfix.log）
#   QQ_CRFIX_IME_DISABLE=1    不加 --enable-wayland-ime / --wayland-text-input-version=1（排查用）
#   QQ_WL_NATIVE_DISABLE=1    关闭屏幕共享修复（排查问题用）
#   QQ_WL_DMABUF=off|first    合成器只给 DMA-BUF 时共享画面用 LINEAR DMA-BUF；
#                             off 关掉，first 让它优先于共享内存（排查用）
#   QQ_WL_FRAME_REUSE_DISABLE=1 关闭「复用采集纹理」（排查共享时内存增长用）
#   QQ_VOICE_LATENCY_MSEC     语音通话麦克风的录音缓冲毫秒数（默认 30；0 关闭，回到 QQ 原本的 2 秒）
#   QQ_CLIPBOARD_FIX_DISABLE=1 关闭剪贴板修复（排查问题用）
#   QQ_SCREENSHOT_FIX_DISABLE=1 关闭截图防闪退（排查问题用）
#   QQ_BORDER_FIX_DISABLE=1   关闭窗口修补（共享边框隐藏、截图覆盖层标题与全屏；排查问题用）

set -u

VERSION="@VERSION@"
LIBDIR="@LIBEXECDIR@"
SCREENSHARE_LIB="$LIBDIR/libqq-wl-portal.so"
CLIPBOARD_LIB="$LIBDIR/libqq-clipbridge.so"
SCREENSHOT_LIB="$LIBDIR/libqq-screenshot.so"
BORDERFIX_LIB="$LIBDIR/libqq-borderfix.so"
LOG="${QQ_CRFIX_LOG:-${XDG_RUNTIME_DIR:-/tmp}/qq-crfix.log}"
QQ_CRASH_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/QQ/crash_files"
CRASH_KEEP="${XDG_CACHE_HOME:-$HOME/.cache}/qq-crfix/crash"
USER_APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
QQ_DESKTOP_IDS=(qq.desktop linuxqq.desktop)
FIX_DESKTOP_ID=qq-crfix.desktop
DESKTOP_MARK=X-LinuxQQ-CrFix
DESKTOP_BACKUP=.qq-crfix.bak

# QQ 崩溃时 Bugly 把调用栈写进 crash_files/tomb_*.txt，但 linuxqq 启动脚本每次都会清空这个目录。
# 启动前把它们复制到缓存目录保存，--doctor 会列出最近的几次。
keep_crash_records() {
    local f
    compgen -G "$QQ_CRASH_DIR/tomb_*.txt" >/dev/null || return 0
    mkdir -p "$CRASH_KEEP" || return 0
    for f in "$QQ_CRASH_DIR"/tomb_*.txt; do
        cp -p "$f" "$CRASH_KEEP/" 2>/dev/null
    done
    ls -1t "$CRASH_KEEP"/tomb_*.txt 2>/dev/null | tail -n +21 | xargs -r rm -f
}

# 优先用 QQ 包自己的 linuxqq 命令（linuxqq 读 qq-flags.conf，linuxqq-appimage 启动 AppImage）。
find_qq() {
    if [[ -n "${QQ_CRFIX_QQ:-}" ]]; then
        echo "$QQ_CRFIX_QQ"
    elif command -v linuxqq >/dev/null 2>&1; then
        command -v linuxqq
    elif [[ -x /opt/QQ/qq ]]; then
        echo /opt/QQ/qq
    fi
}

# 正在运行的 QQ 主进程（安装版在 /opt/QQ/qq，AppImage 版在挂载目录里，可执行文件都叫 qq）。
# 只认本用户、同一 PID 命名空间里的：docker 等容器里的 QQ（如 napcat）在宿主上也能 pgrep 到，要排除。
qq_main_pid() {
    local p cmd self_ns
    self_ns=$(readlink /proc/self/ns/pid)
    for p in $(pgrep -u "$UID" -f '(^|/)qq( |$)'); do
        [[ "$(readlink "/proc/$p/ns/pid" 2>/dev/null)" == "$self_ns" ]] || continue
        cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null) || continue
        [[ "$cmd" == *--type=* ]] && continue
        echo "$p"
        return
    done
}

# 运行中 QQ 主进程的可执行文件；QQ 没运行时退回 /opt/QQ/qq。
# AppImage 版的 exe 在挂载目录里（如 /tmp/.mount_XXXX/.../qq）。
qq_runtime_exe() {
    local p exe
    p=$(qq_main_pid)
    if [[ -n "$p" ]]; then
        exe=$(readlink -f "/proc/$p/exe" 2>/dev/null)
        [[ -n "$exe" && -f "$exe" ]] && { echo "$exe"; return 0; }
    fi
    [[ -x /opt/QQ/qq ]] && echo /opt/QQ/qq
}

# 已安装包的「名 版本」（best-effort，支持 pacman/dpkg/rpm），查不到输出空。
pkg_installed() {
    local p
    for p in "$@"; do
        if command -v pacman >/dev/null 2>&1 && pacman -Q "$p" >/dev/null 2>&1; then
            pacman -Q "$p" 2>/dev/null
            return
        fi
        if command -v dpkg-query >/dev/null 2>&1 && dpkg-query -W "$p" >/dev/null 2>&1; then
            dpkg-query -W -f='${Package} ${Version}\n' "$p" 2>/dev/null
            return
        fi
        if command -v rpm >/dev/null 2>&1 && rpm -q "$p" >/dev/null 2>&1; then
            rpm -q --qf '%{NAME} %{VERSION}-%{RELEASE}\n' "$p" 2>/dev/null
            return
        fi
    done
}

# 文件所属包「名 版本」（best-effort），查不到输出空。
pkg_own() {
    local f="$1" p
    if command -v pacman >/dev/null 2>&1; then
        p=$(pacman -Qoq "$f" 2>/dev/null | head -1)
        [[ -n "$p" ]] && { pacman -Q "$p" 2>/dev/null; return; }
    fi
    if command -v dpkg-query >/dev/null 2>&1; then
        p=$(dpkg -S "$f" 2>/dev/null | head -1 | cut -d: -f1)
        [[ -n "$p" ]] && { dpkg-query -W -f='${Package} ${Version}\n' "$p" 2>/dev/null; return; }
    fi
    if command -v rpm >/dev/null 2>&1; then
        rpm -qf --qf '%{NAME} %{VERSION}-%{RELEASE}\n' "$f" 2>/dev/null
    fi
}

# 已安装的 QQ：包管理器优先（pacman/dpkg/rpm），查不到再退回可执行文件/AppImage。
qq_installed() {
    local out exe
    out=$(pkg_installed linuxqq linuxqq-appimage linuxqq-nt-bwrap)
    if [[ -z "$out" ]]; then
        exe=$(qq_runtime_exe)
        if [[ -n "$exe" ]]; then
            out="手动安装（$exe）"
        elif compgen -G "/opt/linuxqq-appimage/*.AppImage" >/dev/null; then
            out="linuxqq-appimage（未运行）"
        fi
    fi
    echo "$out"
}

# 已安装的 portal 后端（.portal 文件），同名只取第一个；查找目录与 xdg-desktop-portal 相同。
portal_impl_files() {
    local d f n seen=" "
    local -a data
    IFS=: read -ra data <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}" "${data[@]}" /usr/share; do
        for f in "${d%/}"/xdg-desktop-portal/portals/*.portal; do
            [[ -f "$f" ]] || continue
            n=$(basename "$f" .portal)
            [[ "$seen" == *" $n "* ]] && continue
            seen+="$n "
            echo "$f"
        done
    done
}

# portals.conf 里 [preferred] 的某个键，输出后端名，一行一个。
portal_conf_get() {
    awk -F= -v key="$2" '
        /^\[/ { sec = $0; next }
        sec != "[preferred]" { next }
        { k = $1; gsub(/[ \t]/, "", k) }
        k == key {
            n = split(substr($0, index($0, "=") + 1), a, ";")
            for (i = 1; i <= n; i++) { gsub(/[ \t]/, "", a[i]); if (a[i] != "") print a[i] }
            exit
        }' "$1"
}

# 当前桌面下 xdg-desktop-portal 给 ScreenCast 选的后端，输出「.portal 文件<TAB>依据」；没选出来时输出空。
# 规则同 xdg-desktop-portal 1.22：用户配置、系统配置、数据目录里每个目录取一份
# <桌面>-portals.conf（没有就取 portals.conf），按顺序先看接口专门的那一行、再看 default=；
# 都没选出来才退回 .portal 文件里旧的 UseIn，最后是 gtk 兜底。
# 有些合成器没有以自己名字命中的 UseIn，靠 <桌面>-portals.conf 选后端。
portal_backend() {
    local iface=org.freedesktop.impl.portal.ScreenCast
    local base conf de key name f
    local -a desktops cfgdirs datadirs names
    IFS=: read -ra desktops <<< "${XDG_CURRENT_DESKTOP:-}"
    IFS=: read -ra cfgdirs <<< "${XDG_CONFIG_DIRS:-/etc/xdg}"
    IFS=: read -ra datadirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    local -a all sc_impls=()
    mapfile -t all < <(portal_impl_files)
    for f in "${all[@]}"; do
        sed -n 's/^Interfaces=//p' "$f" | tr ';' '\n' | grep -qxF "$iface" && sc_impls+=("$f")
    done

    for base in "${XDG_CONFIG_HOME:-$HOME/.config}" "${cfgdirs[@]}" /etc \
                "${XDG_DATA_HOME:-$HOME/.local/share}" "${datadirs[@]}" /usr/share; do
        conf=""
        for de in "${desktops[@]}" ""; do
            f="${base%/}/xdg-desktop-portal/${de:+${de,,}-}portals.conf"
            [[ -f "$f" ]] && { conf="$f"; break; }
        done
        [[ -n "$conf" ]] || continue
        # 「none」只看接口专门的那一行；没有那一行时才看 default=
        mapfile -t names < <(portal_conf_get "$conf" "$iface")
        [[ ${#names[@]} -gt 0 ]] || mapfile -t names < <(portal_conf_get "$conf" default)
        [[ " ${names[*]} " == *" none "* ]] && return 0
        for key in "$iface" default; do
            mapfile -t names < <(portal_conf_get "$conf" "$key")
            for name in "${names[@]}"; do
                for f in "${sc_impls[@]}"; do
                    [[ "$name" == "*" || "$(basename "$f" .portal)" == "$name" ]] \
                        && { printf '%s\t%s\n' "$f" "$conf"; return 0; }
                done
            done
        done
    done

    for de in "${desktops[@]}"; do
        for f in "${sc_impls[@]}"; do
            sed -n 's/^UseIn=//p' "$f" | tr ';' '\n' | grep -qixF "$de" \
                && { printf '%s\tUseIn\n' "$f"; return 0; }
        done
    done
    for f in "${sc_impls[@]}"; do
        grep -qx 'DBusName=org.freedesktop.impl.portal.desktop.gtk' "$f" \
            && { printf '%s\tgtk 兜底\n' "$f"; return 0; }
    done
}

# portal 接口版本与可用源（best-effort）：如 "ScreenCast v4（显示器、窗口），Screenshot v2"。
portal_interfaces() {
    command -v busctl >/dev/null 2>&1 || return 0
    local base=org.freedesktop.portal.Desktop obj=/org/freedesktop/portal/desktop
    local sc ss types src="" out=""
    sc=$(busctl --user get-property "$base" "$obj" org.freedesktop.portal.ScreenCast version 2>/dev/null | awk '{print $2}')
    ss=$(busctl --user get-property "$base" "$obj" org.freedesktop.portal.Screenshot version 2>/dev/null | awk '{print $2}')
    types=$(busctl --user get-property "$base" "$obj" org.freedesktop.portal.ScreenCast AvailableSourceTypes 2>/dev/null | awk '{print $2}')
    if [[ "$sc" =~ ^[0-9]+$ ]]; then
        out="ScreenCast v$sc"
        if [[ "$types" =~ ^[0-9]+$ ]]; then
            (( types & 1 )) && src="显示器"
            (( types & 2 )) && src="${src:+$src、}窗口"
            (( types & 4 )) && src="${src:+$src、}虚拟屏"
            out+="（${src:-无可用源}）"
        fi
    fi
    [[ "$ss" =~ ^[0-9]+$ ]] && out+="${out:+，}Screenshot v$ss"
    echo "$out"
}

# QQ 的“安装根”（含 resources/app 的目录）：安装版是 /opt/QQ，AppImage 在挂载目录里。
# 从运行中主进程的 exe 向上找；找不到时退回 AppImage 挂载根/exe 所在目录（find 仍能搜到）。
qq_runtime_dir() {
    local exe d i
    exe=$(qq_runtime_exe) || return 1
    d=$(dirname "$exe")
    for i in 1 2 3 4 5; do
        if [[ -e "$d/resources/app" || -e "$d/broadcast-core.so" ]]; then
            echo "$d"
            return 0
        fi
        [[ "$d" == "/" || -z "$d" ]] && break
        d=$(dirname "$d")
    done
    case "$exe" in
        /tmp/.mount_*) echo "$exe" | cut -d/ -f1-3 ;; # AppImage 挂载根
        *) echo "$(dirname "$exe")" ;;
    esac
}

# 剪贴板修复是否启用（只用于日志与自检显示；库自己也读 QQ_CLIPBOARD_FIX_DISABLE）。
clipboard_state() {
    if [[ -n "${QQ_CLIPBOARD_FIX_DISABLE:-}" && "${QQ_CLIPBOARD_FIX_DISABLE}" != 0 ]]; then
        echo off
    else
        echo on
    fi
}

# 当前生效的 QQ 版本目录：热更新版本优先，否则用安装目录。
qq_version_dir() {
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/QQ/versions" cur=""
    if [[ -f "$cfg/config.json" ]]; then
        cur=$(sed -n 's/.*"curVersion"[^"]*"\([^"]*\)".*/\1/p' "$cfg/config.json" | head -1)
    fi
    if [[ -n "$cur" && -d "$cfg/$cur" ]]; then
        echo "$cfg/$cur"
    elif [[ -d /opt/QQ/resources/app ]]; then
        echo /opt/QQ/resources/app
    fi
}

# 系统里的某个 .desktop：先按 XDG_DATA_DIRS 找（与桌面环境的查找方式一致，跳过用户目录），
# 再看 /usr/share 和本包的安装前缀（$LIBDIR 往上两级，如 /usr/lib/<name> -> /usr、Nix 的 store 路径）。
system_desktop() {
    local d dirs
    IFS=: read -ra dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for d in "${dirs[@]}" /usr/share "$(dirname "$(dirname "$LIBDIR")")/share"; do
        d=${d%/}
        [[ -n "$d" && -r "$d/applications/$1" ]] || continue
        [[ "$d/applications" -ef "$USER_APPS" ]] && continue
        echo "$d/applications/$1"
        return 0
    done
    return 1
}

# install / uninstall：覆盖原生 QQ 快捷方式。
# 桌面环境对同名 .desktop 优先用 $XDG_DATA_HOME/applications 里的那份，所以在那里放：
#   - QQ 包入口的副本，Exec 改成本启动器 —— 原来的「QQ」就启动修复版；
#   - qq-crfix.desktop 的副本，加 NoDisplay=true —— 藏起「QQ (CrFix)」，免得菜单里有两个 QQ。
# QQ 包入口：linuxqq 和腾讯官方 deb/rpm 是 qq.desktop，linuxqq-appimage 是 linuxqq.desktop。
# 写入的文件带 X-LinuxQQ-CrFix 标记，uninstall 只删带标记的；用户目录里原有的同名文件先改名备份，uninstall 时还原。
# 副本带 TryExec：本工具被卸载后它不会变成点了没反应的入口，但桌面环境也不会退回 QQ 包的入口
# （GLib 实测：用户目录的同名条目加载失败，整个 ID 就没了），所以卸载本工具前要先 uninstall。
is_our_desktop() {
    [[ -f "$1" ]] && grep -q "^$DESKTOP_MARK=" "$1"
}

# 显示用：家目录缩写成 ~
tilde() {
    [[ "$1" == "$HOME"/* ]] && echo "~${1#"$HOME"}" || echo "$1"
}

# 把 $2 改写后写到用户目录的 $1：override = 改 Exec 启动本启动器；hidden = 加 NoDisplay=true。
# 只动 [Desktop Entry] 组，[Desktop Action ...] 等原样保留。用户目录里原有的同名文件先备份，并输出它的名字。
write_desktop() {
    local id="$1" src="$2" kind="$3" dst="$USER_APPS/$1"
    if [[ -e "$dst" ]] && ! is_our_desktop "$dst"; then
        mv -f "$dst" "$dst$DESKTOP_BACKUP" || return 1
        echo "$id"
    fi
    awk -v kind="$kind" -v mark="$DESKTOP_MARK" '
        function extra() {
            if (kind == "override") {
                print "Exec=qq-crfix %U"
                print "TryExec=qq-crfix"
            } else {
                print "NoDisplay=true"
            }
            print mark "=" kind
        }
        /^\[/ { if (main) extra(); main = ($0 == "[Desktop Entry]"); print; next }
        main && /^(NoDisplay|Hidden)[ \t]*=/ { next }
        main && kind == "override" && /^(Exec|TryExec|DBusActivatable)[ \t]*=/ { next }
        { print }
        END { if (main) extra() }
    ' "$src" > "$dst.tmp" && mv -f "$dst.tmp" "$dst"
}

# 用户目录原本有 mimeinfo.cache 才刷新它；没有就不生成，免得以后过期
refresh_user_apps() {
    [[ -f "$USER_APPS/mimeinfo.cache" ]] && command -v update-desktop-database >/dev/null 2>&1 &&
        update-desktop-database -q "$USER_APPS" 2>/dev/null
    return 0
}

tick() { printf '\e[32m✓\e[0m %s\n' "$*"; }

install_desktop() {
    local id src b t targets=() backed=() hidden=0
    for id in "${QQ_DESKTOP_IDS[@]}"; do
        src=$(system_desktop "$id") && targets+=("$id=$src")
    done
    if [[ ${#targets[@]} -eq 0 ]]; then
        echo "qq-crfix: 找不到 QQ 的快捷方式（${QQ_DESKTOP_IDS[*]}），确认已安装 linuxqq 或 linuxqq-appimage" >&2
        return 1
    fi
    mkdir -p "$USER_APPS" || return 1
    for t in "${targets[@]}"; do
        b=$(write_desktop "${t%%=*}" "${t#*=}" override) || return 1
        [[ -n "$b" ]] && backed+=("$b")
    done
    if src=$(system_desktop "$FIX_DESKTOP_ID"); then
        b=$(write_desktop "$FIX_DESKTOP_ID" "$src" hidden) || return 1
        [[ -n "$b" ]] && backed+=("$b")
        hidden=1
    fi
    refresh_user_apps
    tick "菜单里的「QQ」改为启动修复版"
    [[ $hidden -eq 1 ]] && tick "隐藏「QQ (CrFix)」"
    for b in "${backed[@]}"; do tick "备份原有的 $b"; done
    echo "恢复原样：qq-crfix uninstall"
}

uninstall_desktop() {
    local id f qq=0 shown=0 restored=()
    for id in "${QQ_DESKTOP_IDS[@]}" "$FIX_DESKTOP_ID"; do
        f="$USER_APPS/$id"
        if is_our_desktop "$f"; then
            rm -f "$f" || return 1
            [[ "$id" == "$FIX_DESKTOP_ID" ]] && shown=1 || qq=1
        fi
        if [[ ! -e "$f" && -e "$f$DESKTOP_BACKUP" ]]; then
            mv "$f$DESKTOP_BACKUP" "$f" || return 1
            restored+=("$id")
        fi
    done
    if [[ $qq -eq 0 && $shown -eq 0 && ${#restored[@]} -eq 0 ]]; then
        echo "没有覆盖过原生 QQ 快捷方式，无需恢复。"
        return 0
    fi
    refresh_user_apps
    [[ $qq -eq 1 ]] && tick "菜单里的「QQ」恢复为原版"
    [[ $shown -eq 1 ]] && tick "重新显示「QQ (CrFix)」"
    for id in "${restored[@]}"; do tick "还原原有的 $id"; done
}

doctor() {
    local ok=0 warn=0 fail=0
    pass() { printf '  \e[32m✓\e[0m %s\n' "$*"; ok=$((ok + 1)); }
    note() { printf '  \e[33m!\e[0m %s\n' "$*"; warn=$((warn + 1)); }
    bad()  { printf '  \e[31m✗\e[0m %s\n' "$*"; fail=$((fail + 1)); }

    echo "Linux QQ ChromeOS Fix (qq-crfix) $VERSION 自检"
    echo
    echo "[基础]"
    local qq; qq=$(find_qq)
    [[ -n "$qq" ]] && pass "QQ 启动方式: $qq" || bad "找不到 QQ（linuxqq 或 /opt/QQ/qq），可用 QQ_CRFIX_QQ 指定"
    local qqinst; qqinst=$(qq_installed)
    if [[ -n "$qqinst" ]]; then
        pass "QQ 安装: $qqinst"
    else
        note "未检测到已安装的 linuxqq / linuxqq-appimage 包（可能手动安装）"
    fi
    local id overridden=()
    for id in "${QQ_DESKTOP_IDS[@]}"; do
        is_our_desktop "$USER_APPS/$id" && overridden+=("$(tilde "$USER_APPS/$id")")
    done
    [[ ${#overridden[@]} -gt 0 ]] && pass "已覆盖原生 QQ 快捷方式: ${overridden[*]}（qq-crfix uninstall 恢复）"
    [[ -r "$SCREENSHARE_LIB" ]] && pass "屏幕共享修复: $SCREENSHARE_LIB" || bad "找不到 $SCREENSHARE_LIB"
    [[ -r "$CLIPBOARD_LIB" ]] && pass "剪贴板修复: $CLIPBOARD_LIB" || bad "找不到 $CLIPBOARD_LIB"
    [[ -r "$SCREENSHOT_LIB" ]] && pass "截图防闪退: $SCREENSHOT_LIB" || bad "找不到 $SCREENSHOT_LIB"
    # 截图链：靠合成器的截屏协议，ext-image-copy-capture 优先、wlr-screencopy 兜底。
    # Sommelier 可能两种都不提供；此时截图是黑图，但「不闪退」的兜底仍然有效。
    if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wayland-info >/dev/null 2>&1; then
        local globals has_ext=0 has_wlr=0
        globals=$(wayland-info 2>/dev/null)
        [[ "$globals" == *"'ext_image_copy_capture_manager_v1'"* && "$globals" == *"'ext_output_image_capture_source_manager_v1'"* ]] && has_ext=1
        [[ "$globals" == *"'zwlr_screencopy_manager_v1'"* ]] && has_wlr=1
        if (( has_ext )) && [[ -r "$SCREENSHOT_LIB" ]] && grep -aq 'ext-image-copy-capture' "$SCREENSHOT_LIB"; then
            pass "截图: 合成器支持 ext-image-copy-capture"
        elif (( has_wlr )); then
            pass "截图: 合成器支持 wlr-screencopy"
        elif (( has_ext )); then
            bad "截图: 合成器只有 ext-image-copy-capture，这份 libqq-screenshot.so 不支持，截图会全黑，请升级本包"
        else
            bad "截图: 合成器既没有 ext-image-copy-capture 也没有 wlr-screencopy，截图会全黑（不影响不闪退）"
        fi
    fi
    [[ -r "$BORDERFIX_LIB" ]] && pass "窗口修补（共享边框/截图覆盖层）: $BORDERFIX_LIB" || note "找不到 $BORDERFIX_LIB（共享边框会变成窗口、截图覆盖层不平铺）"
    [[ -n "${WAYLAND_DISPLAY:-}" ]] && pass "Wayland 会话: $WAYLAND_DISPLAY" || note "WAYLAND_DISPLAY 为空，不在 Wayland 会话里？"
    [[ -n "${DISPLAY:-}" ]] && pass "XWayland: $DISPLAY" || bad "DISPLAY 为空：QQ 的界面与剪贴板仍需要 XWayland"
    # Crostini：ChromeOS 输入法（crosim）只认 text-input-v1，而 Chromium/Electron 默认要 v3。
    if [[ -n "${QQ_CRFIX_IME_DISABLE:-}" && "${QQ_CRFIX_IME_DISABLE}" != 0 ]]; then
        note "输入法参数: 已被 QQ_CRFIX_IME_DISABLE 关闭（ChromeOS 原生输入法在 QQ 里可能不可用）"
    else
        pass "输入法参数: --enable-wayland-ime --wayland-text-input-version=1（ChromeOS IME / text-input-v1）"
    fi
    if command -v wayland-info >/dev/null 2>&1; then
        local wi_ime
        wi_ime=$(wayland-info 2>/dev/null)
        if grep -q zwp_text_input_manager_v1 <<< "$wi_ime"; then
            pass "输入法协议: 合成器提供 text-input-v1（ChromeOS / Sommelier）"
        else
            note "输入法协议: 没看到 text-input-v1（不是 Crostini 的 Sommelier？ChromeOS 原生输入法可能用不了）"
        fi
    fi
    # 不给 QQ 传任何 ANGLE/Vulkan 参数：Crostini 的虚拟 GPU 走 Vulkan 会让整个 QQ 花屏。
    pass "渲染后端: QQ 默认（不传 --use-angle=*，也不设置 VK_DRIVER_FILES）"

    echo
    echo "[QQ 内部实现（QQ 更新后用来判断修复是否还适用）]"
    local vdir rdir bc av wrapper
    vdir=$(qq_version_dir)
    rdir=$(qq_runtime_dir)
    local roots=()
    [[ -n "$vdir" ]] && roots+=("$vdir")
    [[ -n "$rdir" ]] && roots+=("$rdir")
    roots+=(/opt/QQ)
    bc=$(find "${roots[@]}" -name broadcast-core.so -print -quit 2>/dev/null)
    av=$(find "${roots[@]}" -name libAVSDKPlugin.so -print -quit 2>/dev/null)
    local wrapper_candidates=()
    [[ -n "$vdir" ]] && wrapper_candidates+=("$vdir/wrapper.node")
    if [[ -n "$rdir" ]]; then
        wrapper_candidates+=("$rdir/wrapper.node" "$rdir/resources/app/wrapper.node")
    fi
    wrapper_candidates+=(/opt/QQ/resources/app/wrapper.node)
    wrapper=$(ls "${wrapper_candidates[@]}" 2>/dev/null | head -1)
    if [[ -z "$bc" ]]; then
        if [[ -z "$rdir" && -e /opt/linuxqq-appimage ]]; then
            note "找不到 broadcast-core.so：AppImage 需要 QQ 运行中才能检查内部实现（启动 QQ 后再运行 --doctor）"
        else
            bad "找不到 broadcast-core.so（QQ 版本目录: ${vdir:-?}）"
        fi
    else
        grep -aq MonitorCapture_WaylandProc "$bc" \
            && pass "屏幕共享：存在 Wayland 采集线程" \
            || bad "屏幕共享：没有 MonitorCapture_WaylandProc，QQ 改了采集实现"
        grep -aq XDG_SESSION_TYPE "$bc" \
            && pass "屏幕共享：仍用 XDG_SESSION_TYPE 判断 Wayland" \
            || bad "屏幕共享：broadcast-core 不再读 XDG_SESSION_TYPE"
        local f
        for f in pw_context_connect_fd pw_stream_connect pw_core_disconnect pw_stream_dequeue_buffer; do
            grep -aq "$f" "$bc" || bad "屏幕共享：找不到 $f"
        done
        grep -aq pa_context_get_sink_info_by_name "$bc" \
            && pass "共享电脑声音：仍通过 pa_context_get_sink_info_by_name 查询格式" \
            || note "共享电脑声音：查询方式变了，可能无声"
    fi
    # 窗口几何为空时的崩溃检查（见 qq-wl-portal.c「6.」）：特征码必须恰好出现一次
    local qqbin offs
    qqbin=$(qq_runtime_exe)
    if [[ -f "$qqbin" ]]; then
        offs=$(LC_ALL=C grep -obaF $'\x44\x8b\x7e\x08\x45\x85\xff\x74' "$qqbin" 2>/dev/null | cut -d: -f1)
        if [[ "$offs" =~ ^[0-9]+$ ]] &&
           [[ $(od -An -tx1 -j $((offs + 9)) -N 8 "$qqbin" | tr -d ' \n') == 448b660c4585e474 ]]; then
            pass "共享时防闪退：找到窗口几何检查"
        else
            note "共享时防闪退：QQ 改了实现，显示器坐标不从 0 开始时共享可能闪退（issue #1）"
        fi
    fi
    if [[ -z "$wrapper" ]]; then
        note "找不到 wrapper.node，跳过剪贴板检查"
    elif grep -aq XSetSelectionOwner "$wrapper"; then
        pass "剪贴板：QQ 仍是 X11 实现"
    else
        bad "剪贴板：wrapper.node 不再使用 XSetSelectionOwner，QQ 改了剪贴板实现"
    fi

    echo
    echo "[Crostini / Wayland 会话]"
    local st="${XDG_SESSION_TYPE:-未知}"
    if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
        pass "会话: ${WAYLAND_DISPLAY}（XDG_SESSION_TYPE=$st；启动器会给 QQ 设 x11）"
    else
        note "会话: XDG_SESSION_TYPE=$st，未检测到 WAYLAND_DISPLAY"
    fi
    if command -v pgrep >/dev/null 2>&1 && pgrep -x sommelier >/dev/null 2>&1; then
        pass "Sommelier: 运行中（ChromeOS / Crostini）"
    else
        note "Sommelier: 未检测到（不是标准 Crostini 会话？）"
    fi
    if command -v busctl >/dev/null 2>&1; then
        local psvc pfile pvia pdbus pown pstate pdesc piface ptypes
        psvc=$(pkg_installed xdg-desktop-portal)
        piface=$(portal_interfaces)
        if [[ -n "$piface" ]]; then
            pfile=$(portal_backend)
            pvia=${pfile#*$'\t'}
            pfile=${pfile%%$'\t'*}
            [[ "$pvia" == "$HOME"/* ]] && pvia="~${pvia#"$HOME"}"
            pdesc=""
            if [[ -n "$pfile" ]]; then
                pdbus=$(sed -n 's/^DBusName=\(org\.freedesktop\.impl\.portal\..*\)$/\1/p' "$pfile" | head -1)
                pown=$(pkg_own "$pfile")
                if [[ -n "$pdbus" ]] && busctl --user list 2>/dev/null | grep -F "$pdbus" | grep -q activatable; then
                    pstate="按需启动"
                elif [[ -n "$pdbus" ]] && busctl --user list 2>/dev/null | grep -qF "$pdbus"; then
                    pstate="运行中"
                else
                    pstate="未运行"
                fi
                pdesc="，ScreenCast 后端 $(basename "$pfile")（${pown:+$pown，}$pstate；按 $pvia 选中）"
                if [[ "$pstate" == "未运行" ]]; then
                    note "Portal: ${psvc:-xdg-desktop-portal} 运行中$pdesc"
                else
                    pass "Portal: ${psvc:-xdg-desktop-portal} 运行中$pdesc"
                fi
            elif [[ "$piface" != *ScreenCast* ]]; then
                note "Portal: ${psvc:-xdg-desktop-portal} 运行中（没有选出 ScreenCast 后端，屏幕共享不可用）"
            else
                pass "Portal: ${psvc:-xdg-desktop-portal} 运行中"
            fi
            pass "Portal 接口: $piface"
        else
            bad "Portal: xdg-desktop-portal 不可用（屏幕共享无法工作）"
        fi
        ptypes=$(busctl --user get-property org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop \
                org.freedesktop.portal.ScreenCast AvailableSourceTypes 2>/dev/null | awk '{print $2}')
        [[ -n "$ptypes" && "$ptypes" != 0 ]] && pass "屏幕共享：portal 录屏可用" \
            || bad "屏幕共享：xdg-desktop-portal 没有可用的 ScreenCast 实现"
    else
        note "没有 busctl，跳过 portal 检查"
    fi
    if command -v wayland-info >/dev/null 2>&1; then
        local wi; wi=$(wayland-info 2>/dev/null)
        if grep -q ext_data_control_manager_v1 <<< "$wi"; then
            pass "剪贴板：合成器支持 ext-data-control"
        elif grep -q zwlr_data_control_manager_v1 <<< "$wi"; then
            pass "剪贴板：合成器支持 wlr-data-control"
        else
            bad "剪贴板：合成器不支持 data-control，剪贴板修复无法工作"
        fi
    else
        note "没有 wayland-info，跳过剪贴板协议检查（安装 wayland-utils 可检查）"
    fi
    # Easy Effects 的排除名单在 [StreamInputs] / [StreamOutputs] 的 blocklist=（逗号分隔）。
    # 提到 TRAE 但键不是 blocklist 的行（如 exclude=）Easy Effects 不读，单独指出来，免得用户以为配过了。
    local ee res missing wrong
    for ee in "$HOME/.var/app/com.github.wwmm.easyeffects/config/easyeffects/db/easyeffectsrc" \
              "${XDG_CONFIG_HOME:-$HOME/.config}/easyeffects/db/easyeffectsrc"; do
        [[ -f "$ee" ]] || continue
        res=$(awk -F= '
            /^\[/ { sec = $0; next }
            sec != "[StreamInputs]" && sec != "[StreamOutputs]" { next }
            $1 == "blocklist" {
                n = split(substr($0, length($1) + 2), a, ",")
                for (i = 1; i <= n; i++) if (a[i] == "TRAE") ok[sec] = 1
                next
            }
            /TRAE/ { print "wrong " $1 }
            END {
                if (!ok["[StreamInputs]"]) print "missing 输入"
                if (!ok["[StreamOutputs]"]) print "missing 输出"
            }' "$ee")
        wrong=$(awk '$1 == "wrong" { print $2 "=" }' <<<"$res" | sort -u | paste -sd' ')
        missing=$(awk '$1 == "missing" { printf "「%s」", $2 }' <<<"$res")
        if [[ -n "$wrong" ]]; then
            note "Easy Effects 配置里有 $wrong 写着 TRAE，但 Easy Effects 不读这个键，不会生效；排除名单的键是 blocklist=，请在界面里添加，或删掉这些行（$ee）"
        fi
        if [[ -n "$missing" ]]; then
            note "检测到 Easy Effects：请在$missing的排除名单里加上 TRAE，否则 QQ 一开通话/共享就会崩（$ee）"
        else
            pass "Easy Effects 已排除 QQ（TRAE）"
        fi
    done
    if systemctl --user is-active -q linuxqq-clipsync 2>/dev/null || pgrep -f "(^|/)linuxqq-clipsync( |$)" >/dev/null; then
        note "linuxqq-clipsync 正在运行：本工具已包含剪贴板修复，同时运行会重复同步。请停用：systemctl --user disable --now linuxqq-clipsync"
    fi

    echo
    echo "[正在运行的 QQ]"
    local pid
    pid=$(qq_main_pid)
    if [[ -z "$pid" ]]; then
        pass "QQ 未运行"
    elif tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q 'libqq-wl-portal.so'; then
        pass "QQ（PID $pid）已注入"
    else
        bad "QQ（PID $pid）没有注入：请完全退出 QQ（含托盘），再从「QQ (CrFix)」打开"
    fi

    echo
    echo "[最近的 QQ 崩溃记录]"
    keep_crash_records
    local t
    t=$(ls -1t "$CRASH_KEEP"/tomb_*.txt 2>/dev/null | head -3)
    if [[ -z "$t" ]]; then
        pass "没有崩溃记录"
    else
        while read -r f; do
            note "$(date -r "$f" '+%F %T')  $f"
        done <<< "$t"
    fi

    echo
    echo "通过 $ok，提醒 $warn，失败 $fail。日志：$LOG"
    [[ $fail -eq 0 ]]
}

case "${1:-}" in
    --doctor) doctor; exit $? ;;
    --version) echo "Linux QQ ChromeOS Fix (qq-crfix) $VERSION"; exit 0 ;;
    install) install_desktop; exit $? ;;
    uninstall) uninstall_desktop; exit $? ;;
    --help|-h) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;;
esac

QQ=$(find_qq)
if [[ -z "$QQ" ]]; then
    echo "qq-crfix: 找不到 QQ（linuxqq 或 /opt/QQ/qq），可用 QQ_CRFIX_QQ 指定" >&2
    exit 1
fi

preload=""
for lib in "$SCREENSHARE_LIB" "$CLIPBOARD_LIB" "$SCREENSHOT_LIB" "$BORDERFIX_LIB"; do
    [[ -r "$lib" ]] && preload="${preload:+$preload:}$lib"
done
export LD_PRELOAD="$preload${LD_PRELOAD:+:$LD_PRELOAD}"

# XDG_SESSION_TYPE=x11：让 QQ 界面与音视频 SDK 不拦截共享；
#   注入库只对 broadcast-core.so 改报 wayland，使它走自带的 portal + PipeWire 路径。
# MESA_SHADER_CACHE_DISABLE：QQ 的 libAVSDKPlugin 导出了自带的 ZSTD_* 符号，
#   会劫持 Mesa 着色器缓存的 zstd 解压，导致采集进程崩溃。
export XDG_SESSION_TYPE=x11
export MESA_SHADER_CACHE_DISABLE="${MESA_SHADER_CACHE_DISABLE:-true}"

# 默认启动参数：原生 Wayland + ChromeOS 输入法。
#   ChromeOS 的 crosim 只支持 text-input-v1，Chromium/Electron 默认会去要 v3，
#   不显式指定版本，ChromeOS 原生输入法在 QQ 里就用不了。
#   QQ_CRFIX_IME_DISABLE=1 只关掉这两个 IME 参数（排查用），--ozone-platform=wayland 仍保留。
#   ANGLE/Vulkan 后端刻意一个都不传：Crostini 的虚拟 GPU 走 Vulkan 会让整个 QQ 花屏。
ime_args=(--enable-wayland-ime --wayland-text-input-version=1)
ime_state=on
if [[ -n "${QQ_CRFIX_IME_DISABLE:-}" && "${QQ_CRFIX_IME_DISABLE}" != 0 ]]; then
    ime_args=()
    ime_state=off
fi

keep_crash_records
{ echo "=== qq-crfix $VERSION $(date '+%F %T') $QQ $* ime=$ime_state clipboard=$(clipboard_state)"; } >"$LOG" 2>/dev/null || LOG=/dev/null

exec "$QQ" --ozone-platform=wayland ${ime_args[@]+"${ime_args[@]}"} "$@" >>"$LOG" 2>&1
