#!/bin/bash
# Linux QQ ChromeOS Fix (qq-crfix) @VERSION@ —— 让 Linux QQ 在 ChromeOS Crostini 下以原生 Wayland 舒服地运行。
# https://github.com/Remik1r3n/LinuxQQ-CrFix
#
#   qq-crfix [QQ 的参数...]   启动 QQ（应用菜单里的「QQ (CrFix)」就是它）
#   qq-crfix --doctor         检查运行环境与当前 QQ 版本
#   qq-crfix --version
#   qq-crfix install          覆盖原生 QQ 快捷方式（原来的「QQ」改为启动修复版，隐藏「QQ (CrFix)」）
#   qq-crfix uninstall        取消覆盖，恢复原生 QQ 快捷方式
#
# 默认给 QQ 加的参数：
#   --ozone-platform=wayland --enable-wayland-ime --wayland-text-input-version=1
#   ChromeOS 的输入法（crosim）只支持 text-input-v1，而 Chromium/Electron 默认会去要 v3；
#   后两个参数让 QQ 走 Sommelier 认得的 v1，ChromeOS 原生输入法才能在 QQ 里打字。
#
# 本项目不会给 QQ 传 --use-angle=* 或设置 VK_DRIVER_FILES：
#   Crostini 的 Vulkan（VirGL/Venus 虚拟 GPU）会让整个 QQ 花屏，任何 ANGLE/Vulkan 后端选择都没有意义。
#
# 只注入剪贴板修复库。截图、屏幕共享（含共享电脑声音、共享时防闪退）、
#   共享边框与截图覆盖层等修复，以及 Easy Effects 相关检查均已删除：
#   Crostini 不提供这些功能依赖的 Wayland 协议与 portal，无法实现，也不再伪装会话类型。
#
# 环境变量：
#   QQ_CRFIX_QQ               QQ 的启动命令（默认先找 PATH 里的 linuxqq，再找 /opt/QQ/qq）
#   QQ_CRFIX_LOG              日志文件（默认 $XDG_RUNTIME_DIR/qq-crfix.log）
#   QQ_CRFIX_WAYLAND_DISPLAY  显式指定给 QQ 的 WAYLAND_DISPLAY（连不上就直接报错，不自动回退）
#   QQ_CRFIX_IGNORE_WAYLAND_CHECK=1  跳过启动前的 Wayland socket 可连接性检查（排查用）
#   QQ_CRFIX_IME_DISABLE=1    不加 --enable-wayland-ime / --wayland-text-input-version=1（排查用）
#   QQ_CLIPBOARD_FIX_DISABLE=1 关闭剪贴板修复（排查问题用）

set -u

VERSION="@VERSION@"
LIBDIR="@LIBEXECDIR@"
CLIPBOARD_LIB="$LIBDIR/libqq-clipbridge.so"
LOG="${QQ_CRFIX_LOG:-${XDG_RUNTIME_DIR:-/tmp}/qq-crfix.log}"
QQ_CRASH_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/QQ/crash_files"
CRASH_KEEP="${XDG_CACHE_HOME:-$HOME/.cache}/qq-crfix/crash"
USER_APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
QQ_DESKTOP_IDS=(qq.desktop linuxqq.desktop)
FIX_DESKTOP_ID=qq-crfix.desktop
DESKTOP_MARK=X-LinuxQQ-CrFix
DESKTOP_BACKUP=.qq-crfix.bak

# QQ 崩溃时 Bugly 把调用栈写进 crash_files/tomb_*.txt，但 linuxqq 启动脚本每次都会清空这个目录。
# 启动前把它们复制到缓存目录保存，--doctor 会列出最近的几次。
keep_crash_records() {
    local f
    compgen -G "$QQ_CRASH_DIR/tomb_*.txt" >/dev/null || return 0
    mkdir -p "$CRASH_KEEP" || return 0
    for f in "$QQ_CRASH_DIR"/tomb_*.txt; do
        cp -p "$f" "$CRASH_KEEP/" 2>/dev/null
    done
    ls -1t "$CRASH_KEEP"/tomb_*.txt 2>/dev/null | tail -n +21 | xargs -r rm -f
}

# ---------------------------------------------------------------------------
# 启动前先确认 Wayland display 真的能连上
#
# Crostini 里 $XDG_RUNTIME_DIR/wayland-0 会变成一个「空壳」：socket 文件还在，
# 但 Sommelier 监听的是已被 unlink 的旧 inode（同名 socket 被别的合成器占用过，
# 或 service 重启时 socket 文件被覆盖）。此时 connect() 返回 ECONNREFUSED，
# QQ 的 Ozone/Wayland 初始化失败，随后在退出路径上解引用空指针，直接 SIGSEGV
# （崩溃点 qq+0x2a8d06e；不注入任何库照样崩，与本项目无关）。
# 所以启动前真的连一次：连不上就换一个能连的 display；一个都没有就明确报错，
# 绝不把 QQ 送进段错误。
# ---------------------------------------------------------------------------
wayland_socket_path() {
    local name="${1:-}"
    [[ -n "$name" ]] || return 1
    if [[ "$name" == /* ]]; then
        printf '%s\n' "$name"
    else
        printf '%s\n' "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$name"
    fi
}

wayland_display_ok() {
    local name="${1:-}" path
    path=$(wayland_socket_path "$name") || return 1
    [[ -S "$path" ]] || return 1
    if command -v python3 >/dev/null 2>&1; then
        python3 -c 'import socket,sys; s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM); s.connect(sys.argv[1]); s.close()' \
            "$path" >/dev/null 2>&1
        return $?
    fi
    # 没有 python3 时，用同样能真的 connect 一次的工具兜底。注意不能拿 stat 的文件
    # inode 去比 ss 的 socket inode：两者是不同编号空间，永远不相等，会误判成全不可用。
    if command -v socat >/dev/null 2>&1; then
        socat -u /dev/null "UNIX-CONNECT:$path" >/dev/null 2>&1
        return $?
    fi
    if command -v nc >/dev/null 2>&1 && nc -h 2>&1 | grep -q -- '-U'; then
        nc -U -w 1 "$path" </dev/null >/dev/null 2>&1
        return $?
    fi
    return 0  # 没有能连 Unix socket 的工具：不拦截，保持原行为
}

# 选出可连接的 display，写入 WL_CHOSEN / WL_NOTE；一个都连不上返回 1。
WL_CHOSEN=""
WL_NOTE=""
select_wayland_display() {
    local forced="${QQ_CRFIX_WAYLAND_DISPLAY:-}" cur="${WAYLAND_DISPLAY:-}"
    local runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    local -a cand=()
    local -A seen=()
    local f name
    WL_CHOSEN=""
    WL_NOTE=""

    if [[ -n "$forced" ]]; then
        wayland_display_ok "$forced" || { WL_NOTE="QQ_CRFIX_WAYLAND_DISPLAY=$forced 连不上"; return 1; }
        WL_CHOSEN="$forced"
        [[ "$forced" != "$cur" ]] && WL_NOTE="按 QQ_CRFIX_WAYLAND_DISPLAY 指定 $forced"
        return 0
    fi

    [[ -n "$cur" ]] && cand+=("$cur")
    cand+=(wayland-0 wayland-1)
    for f in "$runtime"/wayland-*; do
        [[ -S "$f" ]] && cand+=("${f##*/}")
    done

    for name in ${cand[@]+"${cand[@]}"}; do
        [[ -n "${seen[$name]:-}" ]] && continue
        seen[$name]=1
        if wayland_display_ok "$name"; then
            WL_CHOSEN="$name"
            [[ "$name" != "$cur" ]] && WL_NOTE="${cur:-WAYLAND_DISPLAY 未设置} 不可连接，已自动改用 $name"
            return 0
        fi
    done
    WL_NOTE="${cur:-WAYLAND_DISPLAY 未设置} 连不上，且 $runtime 下没有可连接的 wayland-* socket"
    return 1
}

# 优先用 QQ 包自己的 linuxqq 命令（linuxqq 读 qq-flags.conf，linuxqq-appimage 启动 AppImage）。
find_qq() {
    if [[ -n "${QQ_CRFIX_QQ:-}" ]]; then
        echo "$QQ_CRFIX_QQ"
    elif command -v linuxqq >/dev/null 2>&1; then
        command -v linuxqq
    elif [[ -x /opt/QQ/qq ]]; then
        echo /opt/QQ/qq
    fi
}

# 正在运行的 QQ 主进程（安装版在 /opt/QQ/qq，AppImage 版在挂载目录里，可执行文件都叫 qq）。
# 只认本用户、同一 PID 命名空间里的：docker 等容器里的 QQ（如 napcat）在宿主上也能 pgrep 到，要排除。
qq_main_pid() {
    local p cmd self_ns
    self_ns=$(readlink /proc/self/ns/pid)
    for p in $(pgrep -u "$UID" -f '(^|/)qq( |$)'); do
        [[ "$(readlink "/proc/$p/ns/pid" 2>/dev/null)" == "$self_ns" ]] || continue
        cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null) || continue
        [[ "$cmd" == *--type=* ]] && continue
        echo "$p"
        return
    done
}

# 运行中 QQ 主进程的可执行文件；QQ 没运行时退回 /opt/QQ/qq。
# AppImage 版的 exe 在挂载目录里（如 /tmp/.mount_XXXX/.../qq）。
qq_runtime_exe() {
    local p exe
    p=$(qq_main_pid)
    if [[ -n "$p" ]]; then
        exe=$(readlink -f "/proc/$p/exe" 2>/dev/null)
        [[ -n "$exe" && -f "$exe" ]] && { echo "$exe"; return 0; }
    fi
    [[ -x /opt/QQ/qq ]] && echo /opt/QQ/qq
}

# 已安装包的「名 版本」（best-effort，支持 pacman/dpkg/rpm），查不到输出空。
pkg_installed() {
    local p
    for p in "$@"; do
        if command -v pacman >/dev/null 2>&1 && pacman -Q "$p" >/dev/null 2>&1; then
            pacman -Q "$p" 2>/dev/null
            return
        fi
        if command -v dpkg-query >/dev/null 2>&1 && dpkg-query -W "$p" >/dev/null 2>&1; then
            dpkg-query -W -f='${Package} ${Version}\n' "$p" 2>/dev/null
            return
        fi
        if command -v rpm >/dev/null 2>&1 && rpm -q "$p" >/dev/null 2>&1; then
            rpm -q --qf '%{NAME} %{VERSION}-%{RELEASE}\n' "$p" 2>/dev/null
            return
        fi
    done
}

# 已安装的 QQ：包管理器优先（pacman/dpkg/rpm），查不到再退回可执行文件/AppImage。
qq_installed() {
    local out exe
    out=$(pkg_installed linuxqq linuxqq-appimage linuxqq-nt-bwrap)
    if [[ -z "$out" ]]; then
        exe=$(qq_runtime_exe)
        if [[ -n "$exe" ]]; then
            out="手动安装（$exe）"
        elif compgen -G "/opt/linuxqq-appimage/*.AppImage" >/dev/null; then
            out="linuxqq-appimage（未运行）"
        fi
    fi
    echo "$out"
}

# QQ 的「安装根」（含 resources/app 的目录）：安装版是 /opt/QQ，AppImage 在挂载目录里。
# 从运行中主进程的 exe 向上找；找不到时退回 AppImage 挂载根/exe 所在目录（find 仍能搜到）。
qq_runtime_dir() {
    local exe d i
    exe=$(qq_runtime_exe) || return 1
    d=$(dirname "$exe")
    for i in 1 2 3 4 5; do
        if [[ -e "$d/resources/app" ]]; then
            echo "$d"
            return 0
        fi
        [[ "$d" == "/" || -z "$d" ]] && break
        d=$(dirname "$d")
    done
    case "$exe" in
        /tmp/.mount_*) echo "$exe" | cut -d/ -f1-3 ;; # AppImage 挂载根
        *) echo "$(dirname "$exe")" ;;
    esac
}

# 剪贴板修复是否启用（只用于日志与自检显示；库自己也读 QQ_CLIPBOARD_FIX_DISABLE）。
clipboard_state() {
    if [[ -n "${QQ_CLIPBOARD_FIX_DISABLE:-}" && "${QQ_CLIPBOARD_FIX_DISABLE}" != 0 ]]; then
        echo off
    else
        echo on
    fi
}

# 当前生效的 QQ 版本目录：热更新版本优先，否则用安装目录。
qq_version_dir() {
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/QQ/versions" cur=""
    if [[ -f "$cfg/config.json" ]]; then
        cur=$(sed -n 's/.*"curVersion"[^"]*"\([^"]*\)".*/\1/p' "$cfg/config.json" | head -1)
    fi
    if [[ -n "$cur" && -d "$cfg/$cur" ]]; then
        echo "$cfg/$cur"
    elif [[ -d /opt/QQ/resources/app ]]; then
        echo /opt/QQ/resources/app
    fi
}

# 系统里的某个 .desktop：先按 XDG_DATA_DIRS 找（与桌面环境的查找方式一致，跳过用户目录），
# 再看 /usr/share 和本包的安装前缀（$LIBDIR 往上两级，如 /usr/lib/<name> -> /usr、Nix 的 store 路径）。
system_desktop() {
    local d dirs
    IFS=: read -ra dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for d in "${dirs[@]}" /usr/share "$(dirname "$(dirname "$LIBDIR")")/share"; do
        d=${d%/}
        [[ -n "$d" && -r "$d/applications/$1" ]] || continue
        [[ "$d/applications" -ef "$USER_APPS" ]] && continue
        echo "$d/applications/$1"
        return 0
    done
    return 1
}

# install / uninstall：覆盖原生 QQ 快捷方式。
# 桌面环境对同名 .desktop 优先用 $XDG_DATA_HOME/applications 里的那份，所以在那里放：
#   - QQ 包入口的副本，Exec 改成本启动器 —— 原来的「QQ」就启动修复版；
#   - qq-crfix.desktop 的副本，加 NoDisplay=true —— 藏起「QQ (CrFix)」，免得菜单里有两个 QQ。
# QQ 包入口：linuxqq 和腾讯官方 deb/rpm 是 qq.desktop，linuxqq-appimage 是 linuxqq.desktop。
# 写入的文件带 X-LinuxQQ-CrFix 标记，uninstall 只删带标记的；用户目录里原有的同名文件先改名备份，uninstall 时还原。
# 副本带 TryExec：本工具被卸载后它不会变成点了没反应的入口，但桌面环境也不会退回 QQ 包的入口
# （GLib 实测：用户目录的同名条目加载失败，整个 ID 就没了），所以卸载本工具前要先 uninstall。
is_our_desktop() {
    [[ -f "$1" ]] && grep -q "^$DESKTOP_MARK=" "$1"
}

# 显示用：家目录缩写成 ~
tilde() {
    [[ "$1" == "$HOME"/* ]] && echo "~${1#"$HOME"}" || echo "$1"
}

# 把 $2 改写后写到用户目录的 $1：override = 改 Exec 启动本启动器；hidden = 加 NoDisplay=true。
# 只动 [Desktop Entry] 组，[Desktop Action ...] 等原样保留。用户目录里原有的同名文件先备份，并输出它的名字。
write_desktop() {
    local id="$1" src="$2" kind="$3" dst="$USER_APPS/$1"
    if [[ -e "$dst" ]] && ! is_our_desktop "$dst"; then
        mv -f "$dst" "$dst$DESKTOP_BACKUP" || return 1
        echo "$id"
    fi
    awk -v kind="$kind" -v mark="$DESKTOP_MARK" '
        function extra() {
            if (kind == "override") {
                print "Exec=qq-crfix %U"
                print "TryExec=qq-crfix"
            } else {
                print "NoDisplay=true"
            }
            print mark "=" kind
        }
        /^\[/ { if (main) extra(); main = ($0 == "[Desktop Entry]"); print; next }
        main && /^(NoDisplay|Hidden)[ \t]*=/ { next }
        main && kind == "override" && /^(Exec|TryExec|DBusActivatable)[ \t]*=/ { next }
        { print }
        END { if (main) extra() }
    ' "$src" > "$dst.tmp" && mv -f "$dst.tmp" "$dst"
}

# 用户目录原本有 mimeinfo.cache 才刷新它；没有就不生成，免得以后过期
refresh_user_apps() {
    [[ -f "$USER_APPS/mimeinfo.cache" ]] && command -v update-desktop-database >/dev/null 2>&1 &&
        update-desktop-database -q "$USER_APPS" 2>/dev/null
    return 0
}

tick() { printf '\e[32m✓\e[0m %s\n' "$*"; }

install_desktop() {
    local id src b t targets=() backed=() hidden=0
    for id in "${QQ_DESKTOP_IDS[@]}"; do
        src=$(system_desktop "$id") && targets+=("$id=$src")
    done
    if [[ ${#targets[@]} -eq 0 ]]; then
        echo "qq-crfix: 找不到 QQ 的快捷方式（${QQ_DESKTOP_IDS[*]}），确认已安装 linuxqq 或 linuxqq-appimage" >&2
        return 1
    fi
    mkdir -p "$USER_APPS" || return 1
    for t in "${targets[@]}"; do
        b=$(write_desktop "${t%%=*}" "${t#*=}" override) || return 1
        [[ -n "$b" ]] && backed+=("$b")
    done
    if src=$(system_desktop "$FIX_DESKTOP_ID"); then
        b=$(write_desktop "$FIX_DESKTOP_ID" "$src" hidden) || return 1
        [[ -n "$b" ]] && backed+=("$b")
        hidden=1
    fi
    refresh_user_apps
    tick "菜单里的「QQ」改为启动修复版"
    [[ $hidden -eq 1 ]] && tick "隐藏「QQ (CrFix)」"
    for b in "${backed[@]}"; do tick "备份原有的 $b"; done
    echo "恢复原样：qq-crfix uninstall"
}

uninstall_desktop() {
    local id f qq=0 shown=0 restored=()
    for id in "${QQ_DESKTOP_IDS[@]}" "$FIX_DESKTOP_ID"; do
        f="$USER_APPS/$id"
        if is_our_desktop "$f"; then
            rm -f "$f" || return 1
            [[ "$id" == "$FIX_DESKTOP_ID" ]] && shown=1 || qq=1
        fi
        if [[ ! -e "$f" && -e "$f$DESKTOP_BACKUP" ]]; then
            mv "$f$DESKTOP_BACKUP" "$f" || return 1
            restored+=("$id")
        fi
    done
    if [[ $qq -eq 0 && $shown -eq 0 && ${#restored[@]} -eq 0 ]]; then
        echo "没有覆盖过原生 QQ 快捷方式，无需恢复。"
        return 0
    fi
    refresh_user_apps
    [[ $qq -eq 1 ]] && tick "菜单里的「QQ」恢复为原版"
    [[ $shown -eq 1 ]] && tick "重新显示「QQ (CrFix)」"
    for id in "${restored[@]}"; do tick "还原原有的 $id"; done
}

doctor() {
    local ok=0 warn=0 fail=0
    pass() { printf '  \e[32m✓\e[0m %s\n' "$*"; ok=$((ok + 1)); }
    note() { printf '  \e[33m!\e[0m %s\n' "$*"; warn=$((warn + 1)); }
    bad()  { printf '  \e[31m✗\e[0m %s\n' "$*"; fail=$((fail + 1)); }

    echo "Linux QQ ChromeOS Fix (qq-crfix) $VERSION 自检"
    echo
    echo "[基础]"
    local qq; qq=$(find_qq)
    [[ -n "$qq" ]] && pass "QQ 启动方式: $qq" || bad "找不到 QQ（linuxqq 或 /opt/QQ/qq），可用 QQ_CRFIX_QQ 指定"
    local qqinst; qqinst=$(qq_installed)
    if [[ -n "$qqinst" ]]; then
        pass "QQ 安装: $qqinst"
    else
        note "未检测到已安装的 linuxqq / linuxqq-appimage 包（可能手动安装）"
    fi
    local id overridden=()
    for id in "${QQ_DESKTOP_IDS[@]}"; do
        is_our_desktop "$USER_APPS/$id" && overridden+=("$(tilde "$USER_APPS/$id")")
    done
    [[ ${#overridden[@]} -gt 0 ]] && pass "已覆盖原生 QQ 快捷方式: ${overridden[*]}（qq-crfix uninstall 恢复）"
    [[ -r "$CLIPBOARD_LIB" ]] && pass "剪贴板修复: $CLIPBOARD_LIB" || bad "找不到 $CLIPBOARD_LIB"
    if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
        note "Wayland 会话: WAYLAND_DISPLAY 为空，不在 Wayland 会话里？"
    elif wayland_display_ok "$WAYLAND_DISPLAY"; then
        pass "Wayland 会话: $WAYLAND_DISPLAY（socket 可连接）"
    else
        bad "Wayland 会话: $WAYLAND_DISPLAY 的 socket 连不上（QQ 会段错误，详见下方会话段）"
    fi
    [[ -n "${DISPLAY:-}" ]] && pass "XWayland: $DISPLAY" || bad "DISPLAY 为空：QQ 的界面与剪贴板仍需要 XWayland"
    # Crostini：ChromeOS 输入法（crosim）只认 text-input-v1，而 Chromium/Electron 默认要 v3。
    if [[ -n "${QQ_CRFIX_IME_DISABLE:-}" && "${QQ_CRFIX_IME_DISABLE}" != 0 ]]; then
        note "输入法参数: 已被 QQ_CRFIX_IME_DISABLE 关闭（ChromeOS 原生输入法在 QQ 里可能不可用）"
    else
        pass "输入法参数: --enable-wayland-ime --wayland-text-input-version=1（ChromeOS IME / text-input-v1）"
    fi
    if command -v wayland-info >/dev/null 2>&1; then
        local wi_ime
        wi_ime=$(wayland-info 2>/dev/null)
        if grep -q zwp_text_input_manager_v1 <<< "$wi_ime"; then
            pass "输入法协议: 合成器提供 text-input-v1（ChromeOS / Sommelier）"
        else
            note "输入法协议: 没看到 text-input-v1（不是 Crostini 的 Sommelier？ChromeOS 原生输入法可能用不了）"
        fi
    fi
    # 不给 QQ 传任何 ANGLE/Vulkan 参数：Crostini 的虚拟 GPU 走 Vulkan 会让整个 QQ 花屏。
    pass "渲染后端: QQ 默认（不传 --use-angle=*，也不设置 VK_DRIVER_FILES）"

    echo
    echo "[QQ 内部实现（QQ 更新后用来判断修复是否还适用）]"
    local vdir rdir wrapper
    vdir=$(qq_version_dir)
    rdir=$(qq_runtime_dir)
    local wrapper_candidates=()
    [[ -n "$vdir" ]] && wrapper_candidates+=("$vdir/wrapper.node")
    if [[ -n "$rdir" ]]; then
        wrapper_candidates+=("$rdir/wrapper.node" "$rdir/resources/app/wrapper.node")
    fi
    wrapper_candidates+=(/opt/QQ/resources/app/wrapper.node)
    wrapper=$(ls "${wrapper_candidates[@]}" 2>/dev/null | head -1)
    if [[ -z "$wrapper" ]]; then
        note "找不到 wrapper.node，跳过剪贴板检查（AppImage 版需要 QQ 运行中才能检查）"
    elif grep -aq XSetSelectionOwner "$wrapper"; then
        pass "剪贴板：QQ 仍是 X11 实现"
    else
        bad "剪贴板：wrapper.node 不再使用 XSetSelectionOwner，QQ 改了剪贴板实现"
    fi

    echo
    echo "[Crostini / Wayland 会话]"
    local st="${XDG_SESSION_TYPE:-未知}" cur="${WAYLAND_DISPLAY:-}" alt="" f
    if [[ -n "$cur" ]] && wayland_display_ok "$cur"; then
        pass "会话: ${cur} 可连接（XDG_SESSION_TYPE=$st）"
    elif [[ -n "$cur" ]]; then
        bad "会话: ${cur} 的 socket 连不上（文件与 Sommelier 监听的 socket 不一致？），QQ 会直接 SIGSEGV"
        for f in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/wayland-*; do
            [[ -S "$f" ]] || continue
            if wayland_display_ok "${f##*/}"; then alt="${f##*/}"; break; fi
        done
        if [[ -n "$alt" ]]; then
            note "启动器会自动改用 $alt；也可执行 systemctl --user restart sommelier@0.service 修复 $cur"
        else
            note "没有其它可用 socket：执行 systemctl --user restart sommelier@0.service 修复 $cur"
        fi
    else
        note "会话: XDG_SESSION_TYPE=$st，未检测到 WAYLAND_DISPLAY（启动器会自动挑一个可连接的 socket）"
    fi
    if command -v pgrep >/dev/null 2>&1 && pgrep -f '[s]ommelier' >/dev/null 2>&1; then
        pass "Sommelier: 运行中（ChromeOS / Crostini）"
    else
        note "Sommelier: 未检测到（不是标准 Crostini 会话？）"
    fi
    if command -v wayland-info >/dev/null 2>&1; then
        local wi; wi=$(wayland-info 2>/dev/null)
        if grep -q ext_data_control_manager_v1 <<< "$wi"; then
            pass "剪贴板：合成器支持 ext-data-control"
        elif grep -q zwlr_data_control_manager_v1 <<< "$wi"; then
            pass "剪贴板：合成器支持 wlr-data-control"
        else
            bad "剪贴板：合成器不支持 data-control，剪贴板修复无法工作"
        fi
    else
        note "没有 wayland-info，跳过剪贴板协议检查（安装 wayland-utils 可检查）"
    fi
    if systemctl --user is-active -q linuxqq-clipsync 2>/dev/null || pgrep -f "(^|/)linuxqq-clipsync( |$)" >/dev/null; then
        note "linuxqq-clipsync 正在运行：本工具已包含剪贴板修复，同时运行会重复同步。请停用：systemctl --user disable --now linuxqq-clipsync"
    fi

    echo
    echo "[正在运行的 QQ]"
    local pid
    pid=$(qq_main_pid)
    if [[ -z "$pid" ]]; then
        pass "QQ 未运行"
    elif tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q 'libqq-clipbridge.so'; then
        pass "QQ（PID $pid）已注入"
    else
        bad "QQ（PID $pid）没有注入：请完全退出 QQ（含托盘），再从「QQ (CrFix)」打开"
    fi

    echo
    echo "[最近的 QQ 崩溃记录]"
    keep_crash_records
    local t
    t=$(ls -1t "$CRASH_KEEP"/tomb_*.txt 2>/dev/null | head -3)
    if [[ -z "$t" ]]; then
        pass "没有崩溃记录"
    else
        while read -r f; do
            note "$(date -r "$f" '+%F %T')  $f"
        done <<< "$t"
    fi

    echo
    echo "通过 $ok，提醒 $warn，失败 $fail。日志：$LOG"
    [[ $fail -eq 0 ]]
}

case "${1:-}" in
    --doctor) doctor; exit $? ;;
    --version) echo "Linux QQ ChromeOS Fix (qq-crfix) $VERSION"; exit 0 ;;
    install) install_desktop; exit $? ;;
    uninstall) uninstall_desktop; exit $? ;;
    --help|-h) sed -n '2,/^[^#]/s/^# \{0,1\}//p' "$0"; exit 0 ;;
esac

QQ=$(find_qq)
if [[ -z "$QQ" ]]; then
    echo "qq-crfix: 找不到 QQ（linuxqq 或 /opt/QQ/qq），可用 QQ_CRFIX_QQ 指定" >&2
    exit 1
fi

# 启动前确认 Wayland socket 可连：坏 socket 会让 QQ 直接 SIGSEGV，见上面的函数说明。
wl_log=skip
if [[ -n "${QQ_CRFIX_IGNORE_WAYLAND_CHECK:-}" && "${QQ_CRFIX_IGNORE_WAYLAND_CHECK}" != 0 ]]; then
    WL_NOTE=""
elif select_wayland_display; then
    export WAYLAND_DISPLAY="$WL_CHOSEN"
    wl_log="$WL_CHOSEN"
    [[ -z "$WL_NOTE" ]] || echo "qq-crfix: $WL_NOTE" >&2
else
    echo "qq-crfix: $WL_NOTE" >&2
    echo "qq-crfix: 没有可连接的 Wayland display，拒绝启动 QQ —— 否则 Ozone/Wayland 初始化失败后 QQ 会直接 SIGSEGV。" >&2
    echo "qq-crfix: 修复环境：systemctl --user restart sommelier@0.service" >&2
    echo "qq-crfix: 或指定可用显示：QQ_CRFIX_WAYLAND_DISPLAY=wayland-1 qq-crfix；用 qq-crfix --doctor 查看可用 socket。" >&2
    exit 3
fi

preload=""
for lib in "$CLIPBOARD_LIB"; do
    [[ -r "$lib" ]] && preload="${preload:+$preload:}$lib"
done
export LD_PRELOAD="$preload${LD_PRELOAD:+:$LD_PRELOAD}"

# MESA_SHADER_CACHE_DISABLE：QQ 的 libAVSDKPlugin.so 导出了自带的 ZSTD_* 符号，
#   会劫持 Mesa 着色器缓存的 zstd 解压导致崩溃；禁用磁盘着色器缓存绕开这处冲突。
export MESA_SHADER_CACHE_DISABLE="${MESA_SHADER_CACHE_DISABLE:-true}"

# 默认启动参数：原生 Wayland + ChromeOS 输入法。
#   ChromeOS 的 crosim 只支持 text-input-v1，Chromium/Electron 默认会去要 v3，
#   不显式指定版本，ChromeOS 原生输入法在 QQ 里就用不了。
#   QQ_CRFIX_IME_DISABLE=1 只关掉这两个 IME 参数（排查用），--ozone-platform=wayland 仍保留。
#   ANGLE/Vulkan 后端刻意一个都不传：Crostini 的虚拟 GPU 走 Vulkan 会让整个 QQ 花屏。
#   XDG_SESSION_TYPE 保持环境原值，不再伪装成 x11（那原本是给屏幕共享/截图修复用的）。
ime_args=(--enable-wayland-ime --wayland-text-input-version=1)
ime_state=on
if [[ -n "${QQ_CRFIX_IME_DISABLE:-}" && "${QQ_CRFIX_IME_DISABLE}" != 0 ]]; then
    ime_args=()
    ime_state=off
fi

keep_crash_records
{
    echo "=== qq-crfix $VERSION $(date '+%F %T') $QQ $* ime=$ime_state clipboard=$(clipboard_state) wl=$wl_log"
    [[ -z "$WL_NOTE" ]] || echo "qq-crfix: $WL_NOTE"
} >"$LOG" 2>/dev/null || LOG=/dev/null

exec "$QQ" --ozone-platform=wayland ${ime_args[@]+"${ime_args[@]}"} "$@" >>"$LOG" 2>&1
